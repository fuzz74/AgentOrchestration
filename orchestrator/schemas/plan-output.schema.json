{
  "type": "object",
  "required": ["tasks", "notes"],
  "properties": {
    "notes": {
      "type": "string",
      "description": "Assumptions, open questions and anything the human should check before running the plan."
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "prompt", "deps", "owns", "acceptance"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,48}$" },
          "title": { "type": "string" },
          "prompt": { "type": "string" },
          "deps": { "type": "array", "items": { "type": "string" } },
          "owns": { "type": "array", "items": { "type": "string" } },
          "acceptance": { "type": "string" }
        }
      }
    }
  }
}
